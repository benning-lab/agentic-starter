# Ghostty terminal config. Symlink to ~/.config/ghostty/config:
#   ln -sfn "$PWD/dotfiles/ghostty.config" ~/.config/ghostty/config
# Companion to dotfiles/tmux.conf. Reload: Cmd+Shift+, or restart Ghostty.
# NOTE: Ghostty does NOT allow trailing "# comments" on a value line — they get
# parsed into the value. Keep comments on their own lines.

# --- font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 15

# a little extra line spacing -> easier long-session reading
adjust-cell-height = 12%

# --- theme (dark, ships built-in) ---
theme = Catppuccin Mocha

# --- window / spacing ---
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs

# --- behavior ---
# Option -> Alt so tmux Alt+arrow pane-nav works
macos-option-as-alt = true
mouse-hide-while-typing = true
cursor-style = bar
# selection -> clipboard, matches the tmux.conf behavior
copy-on-select = clipboard

# --- roomy default window so Claude Code diffs/tables render wide ---
window-width = 140
window-height = 40
