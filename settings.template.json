{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "__REPO__/hooks/session-start-handoff.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__REPO__/hooks/capture-session.sh" }
        ]
      }
    ]
  }
}
